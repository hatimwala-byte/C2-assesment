# Copy to .env in this directory (or export in your shell / IDE run config).
# Never commit real credentials.

# Active Spring profile: h2 (default file-backed local DB) or postgres
SPRING_PROFILES_ACTIVE=h2

# --- postgres profile only (required when SPRING_PROFILES_ACTIVE=postgres) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tickets
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# Optional: dev CORS origins (comma-separated) when CORS config is enabled
# CORS_ALLOWED_ORIGINS=http://localhost:5173
